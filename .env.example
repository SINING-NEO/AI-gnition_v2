# Copy this file to .env and replace the placeholder values locally.
# Never commit the completed .env file or share passwords in chat.

# SMTP server settings
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls

# SMTP login credentials
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password-or-app-password

# Visible sender details
SMTP_FROM_EMAIL=verified-sender@example.com
SMTP_FROM_NAME=Pantry & Co. Prototype
